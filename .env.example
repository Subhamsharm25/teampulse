# Copy to .env (never commit .env). Every variable is read by src/teampulse/config.py.
TEAMPULSE_COMPANY=Acme Labs
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
TEAMPULSE_SECRET_KEY=change-me
TEAMPULSE_TZ=Asia/Kolkata
# Monday=0 ... Sunday=6
TEAMPULSE_WORKDAYS=0,1,2,3,4
# Below this share of the daily target a day counts as "under target"
TEAMPULSE_UNDER_RATIO=0.75
# Set to true when served over HTTPS
TEAMPULSE_SECURE_COOKIES=false
